# Plantilla sin secretos. La custodia de claves Ed25519 y tokens de Rafiki es manual (BE-1).
DATABASE_URL=postgresql://taskstream:taskstream@localhost:5432/taskstream
DIRECT_URL=postgresql://taskstream:taskstream@localhost:5432/taskstream
PORT=3001
PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Clerk v6 (SPEC-02)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_sample_webhook_signing_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Cliente GNAP de la plataforma. No es la wallet del usuario y no se commitea la clave.
# El descubrimiento público no las usa. grant.request y grant.continue sí.
OPEN_PAYMENTS_CLIENT_WALLET_ADDRESS=
OPEN_PAYMENTS_KEY_ID=
OPEN_PAYMENTS_PRIVATE_KEY=
