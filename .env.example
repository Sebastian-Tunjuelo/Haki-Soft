# Plantilla sin secretos. La custodia de claves Ed25519 y tokens de Rafiki es manual (BE-1).
# El Postgres de Docker publica 5433 para no chocar con un Postgres local en 5432.
DATABASE_URL=postgresql://taskstream:taskstream@127.0.0.1:5433/taskstream
DIRECT_URL=postgresql://taskstream:taskstream@127.0.0.1:5433/taskstream
PORT=3001
PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Frontend al que redirige el callback GNAP de wallet (nunca JSON crudo en el navegador).
PUBLIC_WEB_URL=http://localhost:3000
# El BFF de Next reenvÃ­a la sesiÃ³n local a Nest. Si falta, usa NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://localhost:3001
# Redis del docker-compose. Lo usarÃ¡n los relojes BullMQ.
REDIS_URL=redis://localhost:6379
# Consejero IA (SPEC-08 / packages/ai-advisor). Sin clave, usar createFakeAiAdvisorProvider en tests.
GROQ_API_KEY=
# Texto / object generation. NO admite visión (p. ej. llama-3.3-70b-versatile, openai/gpt-oss-*).
AI_ADVISOR_MODEL_ID=llama-3.3-70b-versatile
# Obligatoria para IMAGE multimodal. Sin esto, IMAGE falla cerrado si el modelo principal no es vision.
# Vision en Groq (según cuenta): qwen/qwen3.8-27b | meta-llama/llama-4-scout-17b-16e-instruct | llama-4-maverick
# Mínimo 32px por lado en la imagen enviada a Groq.
AI_ADVISOR_VISION_MODEL_ID=qwen/qwen3.8-27b

# Cliente GNAP de la plataforma (Test Wallet). No es la wallet del usuario.
# El descubrimiento pÃºblico no firma. grant.request, grant.continue y los pagos
# los confirma la API de Open Payments. La clave privada no se escribe en el cÃ³digo
# ni en este ejemplo: va en un archivo local *.key (gitignored) o en .env local.
OPEN_PAYMENTS_CLIENT_WALLET_ADDRESS=https://ilp.interledger-test.dev/633c95b8
OPEN_PAYMENTS_KEY_ID=927b39ea-a362-4484-879e-a8e9bf0ae16f
OPEN_PAYMENTS_PRIVATE_KEY=
OPEN_PAYMENTS_PRIVATE_KEY_PATH=
# Pagos reales en Test Wallet (EGG/USD segÃºn la wallet). Sin esto sigue el simulador.
OPEN_PAYMENTS_REAL=0
# Wallet de custodia (debe ser una que controles con claves/token). Por defecto = CLIENT.
OPEN_PAYMENTS_ESCROW_WALLET_ADDRESS=
# Token de larga duraciÃ³n (outgoing-payment) sobre la wallet de custodia â€” obligatorio para liberar 96/4.
OPEN_PAYMENTS_ESCROW_ACCESS_TOKEN=
# Wallet que recibe el 4 %.
OPEN_PAYMENTS_PLATFORM_OWNER_WALLET_ADDRESS=
