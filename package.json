{
  "name": "taskstream",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "docker:up": "docker compose up -d --wait",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter @taskstream/api exec prisma migrate deploy"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.3"
  }
}
